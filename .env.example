# API mode: prod | dev | local
NEXT_PUBLIC_API_MODE=local

# Local dev: keep true to proxy /api/v1/* through Next.js to backend (recommended)
NEXT_PUBLIC_API_USE_SAME_ORIGIN_PROXY=true
API_PROXY_TARGET=http://127.0.0.1:8000

# API base URLs for different modes
NEXT_PUBLIC_API_BASE_URL_PRODUCTION=https://api.example.com
NEXT_PUBLIC_API_BASE_URL_DEVELOPMENT=https://dev-api.example.com
NEXT_PUBLIC_API_BASE_URL_LOCAL=http://127.0.0.1:8000

# Backend endpoint path for Facebook posts
NEXT_PUBLIC_API_FACEBOOK_POSTS_PATH=/api/v1/customer-app/facebook-posts
